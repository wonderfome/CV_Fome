<html>
<head>
<title>Raster Graphics Assignment 2</title>
<style>
  body {
    font-family: Tahoma, sans-serif;
    background-color: #e0e0e0;
    margin: 20px;
  }
  .box {
    background-color: rgb(107, 121, 173);
    padding: 15px;
    border: 1px solid #999;
    width: fit-content;
  }
  .top-tools {
    margin-bottom: 10px;
    color: white;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .workspace {
    display: flex;
    gap: 10px;
  }

 
  .icon-toolbar {
    display: flex;
    flex-direction: column;
    background-color: #d4d4d4;
    border: 2px solid #888;
    padding: 2px;
    gap: 2px;
  }

  .icon-btn {
    width: 32px;
    height: 32px;
    background-color: #e0e0e0;
    border: 1px solid #fff;
    border-right-color: #777;
    border-bottom-color: #777;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    padding: 0;
  }

  .icon-btn:active {
    border: 1px solid #777;
    border-right-color: #fff;
    border-bottom-color: #fff;
  }

  .icon-btn.active-btn {
    background-color: #c0c0c0;
    border: 1px solid #555;
    box-shadow: inset 1px 1px 2px rgba(0,0,0,0.4);
  }

  .icon-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #000;
    stroke-width: 1.5;
  }
</style>
</head>
<body>

<div class="box">
  
  <div class="top-tools">
    <span>color:</span>
    <input type="color" id="myColor" value="#00ff00">
    
    <span style="margin-left:10px;">size:</span>
    <input type="number" id="mySize" value="1" min="1" max="10" style="width:40px;">

    <button onclick="clearCanvas()" style="margin-left:10px; color:rgb(229, 0, 0); padding: 2px 8px;">Clear</button>
  </div>

  <div class="workspace">
    
    <div class="icon-toolbar">
      
      <button id="b_pencil" class="icon-btn active-btn" title="ดินสอ" onclick="selectTool('pencil')">
        <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
      </button>

      
      <button id="b_eraser" class="icon-btn" title="ยางลบ" onclick="selectTool('eraser')">
        <svg viewBox="0 0 24 24"><path d="M16.24 3.56l4.95 4.95c.78.78.78 2.05 0 2.83L11.7 20.83c-.78.78-2.05.78-2.83 0l-4.95-4.95c-.78-.78-.78-2.05 0-2.83L13.41 3.56c.78-.78 2.05-.78 2.83 0zM9 18.5l9-9"/></svg>
      </button>

      
      <button id="b_rect" class="icon-btn" title="สี่เหลี่ยม (ขอบ)" onclick="selectTool('rect')">
        <svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="10" rx="1"/></svg>
      </button>

      
      <button id="b_rect_fill" class="icon-btn" title="สี่เหลี่ยม (ทึบ)" onclick="selectTool('rect_fill')">
        <svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="10" rx="1" fill="#000"/></svg>
      </button>

      
      <button id="b_circle" class="icon-btn" title="วงกลม (ขอบ)" onclick="selectTool('circle')">
        <svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="8" ry="5"/></svg>
      </button>

      
      <button id="b_circle_fill" class="icon-btn" title="วงกลม (ทึบ)" onclick="selectTool('circle_fill')">
        <svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="8" ry="5" fill="#000"/></svg>
      </button>

      
      <button id="b_line" class="icon-btn" title="เส้นตรง" onclick="selectTool('line')">
        <svg viewBox="0 0 24 24"><line x1="4" y1="20" x2="20" y2="4" stroke-width="2"/></svg>
      </button>
    </div>

    
    <canvas id="canvas" width="200" height="200" 
    style="width:500px; height:500px; border:1px solid #000; image-rendering: pixelated; background:white;">
    </canvas>
  </div>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const imageData = ctx.createImageData(canvas.width, canvas.height);
const pixels = imageData.data;

function putPixel(x, y, r, g, b, a = 255) {
  if (x >= 0 && x < canvas.width && y >= 0 && y < canvas.height) {
    const idx = (y * canvas.width + x) * 4;
    pixels[idx] = r;
    pixels[idx + 1] = g;
    pixels[idx + 2] = b;
    pixels[idx + 3] = a;
  }
}

function putPixelThick(x, y, r, g, b) {
  const size = parseInt(document.getElementById('mySize').value);
  const offset = Math.floor(size / 2);
  for (let i = -offset; i <= offset; i++) {
    for (let j = -offset; j <= offset; j++) {
      putPixel(x + i, y + j, r, g, b);
    }
  }
}

function drawLine(x1, y1, x2, y2, r, g, b) {
  const dx = Math.abs(x2 - x1);
  const dy = Math.abs(y2 - y1);
  
  if (dx === 0 && dy === 0) {
    putPixelThick(x1, y1, r, g, b);
    return;
  }

  if (dx > dy) {
    const m = (y2 - y1) / (x2 - x1);
    const c = y1 - m * x1;
    for (let x = Math.min(x1, x2); x <= Math.max(x1, x2); x++) {
      const y = Math.round(m * x + c);
      putPixelThick(x, y, r, g, b);
    }
  } else {
    const m = (x2 - x1) / (y2 - y1);
    const c = x1 - m * y1;
    for (let y = Math.min(y1, y2); y <= Math.max(y1, y2); y++) {
      const x = Math.round(m * y + c);
      putPixelThick(x, y, r, g, b);
    }
  }
}


function drawRect(x1, y1, x2, y2, r, g, b) {
  drawLine(x1, y1, x2, y1, r, g, b);
  drawLine(x2, y1, x2, y2, r, g, b);
  drawLine(x2, y2, x1, y2, r, g, b);
  drawLine(x1, y2, x1, y1, r, g, b);
}


function drawRectFill(x1, y1, x2, y2, r, g, b) {
  const minX = Math.min(x1, x2), maxX = Math.max(x1, x2);
  const minY = Math.min(y1, y2), maxY = Math.max(y1, y2);
  for (let y = minY; y <= maxY; y++) {
    for (let x = minX; x <= maxX; x++) {
      putPixel(x, y, r, g, b);
    }
  }
}


function drawEllipse(cx, cy, rx, ry, r, g, b) {
  if (rx <= 0 || ry <= 0) return;
  for (let degree = 0; degree < 360; degree++) {
    const rad = degree * Math.PI / 180;
    const x = Math.round(cx + rx * Math.cos(rad));
    const y = Math.round(cy + ry * Math.sin(rad));
    putPixelThick(x, y, r, g, b);
  }
}


function drawEllipseFill(cx, cy, rx, ry, r, g, b) {
  if (rx <= 0 || ry <= 0) return;
  for (let y = -ry; y <= ry; y++) {
    for (let x = -rx; x <= rx; x++) {
      if ((x * x) / (rx * rx) + (y * y) / (ry * ry) <= 1) {
        putPixel(Math.round(cx + x), Math.round(cy + y), r, g, b);
      }
    }
  }
}

function clearCanvas() {
  for (let i = 0; i < pixels.length; i += 4) {
    pixels[i] = 255;
    pixels[i+1] = 255;
    pixels[i+2] = 255;
    pixels[i+3] = 255;
  }
  ctx.putImageData(imageData, 0, 0);
}
clearCanvas();

let mode = 'pencil';
let isDrawing = false;
let startX = 0, startY = 0;
let oldX = 0, oldY = 0;
let tempPixels = new Uint8ClampedArray(pixels.length); 

function selectTool(toolName) {
  mode = toolName;
  document.querySelectorAll('.icon-btn').forEach(btn => btn.classList.remove('active-btn'));
  const activeBtn = document.getElementById('b_' + toolName);
  if (activeBtn) activeBtn.classList.add('active-btn');
}


function getRGBColor() {
  if (mode === 'eraser') return { r: 255, g: 255, b: 255 };
  const hex = document.getElementById('myColor').value;
  return {
    r: parseInt(hex.substring(1, 3), 16),
    g: parseInt(hex.substring(3, 5), 16),
    b: parseInt(hex.substring(5, 7), 16)
  };
}

function getMousePosition(e) {
  const rect = canvas.getBoundingClientRect();
  return {
    x: Math.floor((e.clientX - rect.left) * (canvas.width / rect.width)),
    y: Math.floor((e.clientY - rect.top) * (canvas.height / rect.height))
  };
}

canvas.addEventListener('mousedown', function(e) {
  isDrawing = true;
  const pos = getMousePosition(e);
  startX = pos.x;
  startY = pos.y;
  oldX = pos.x;
  oldY = pos.y;
  
  tempPixels.set(pixels);

  if (mode === 'pencil' || mode === 'eraser') {
    const c = getRGBColor();
    putPixelThick(pos.x, pos.y, c.r, c.g, c.b);
    ctx.putImageData(imageData, 0, 0);
  }
});

canvas.addEventListener('mousemove', function(e) {
  if (!isDrawing) return;
  
  const pos = getMousePosition(e);
  const c = getRGBColor();

  if (mode === 'pencil' || mode === 'eraser') {
    drawLine(oldX, oldY, pos.x, pos.y, c.r, c.g, c.b);
    oldX = pos.x;
    oldY = pos.y;
  } else {
    pixels.set(tempPixels);
    
    if (mode === 'line') {
      drawLine(startX, startY, pos.x, pos.y, c.r, c.g, c.b);
    } else if (mode === 'rect') {
      drawRect(startX, startY, pos.x, pos.y, c.r, c.g, c.b);
    } else if (mode === 'rect_fill') {
      drawRectFill(startX, startY, pos.x, pos.y, c.r, c.g, c.b);
    } else if (mode === 'circle' || mode === 'circle_fill') {
      const rx = Math.abs(pos.x - startX) / 2;
      const ry = Math.abs(pos.y - startY) / 2;
      const cx = Math.min(startX, pos.x) + rx;
      const cy = Math.min(startY, pos.y) + ry;
      if (mode === 'circle') drawEllipse(cx, cy, rx, ry, c.r, c.g, c.b);
      if (mode === 'circle_fill') drawEllipseFill(cx, cy, rx, ry, c.r, c.g, c.b);
    }
  }

  ctx.putImageData(imageData, 0, 0);
});

canvas.addEventListener('mouseup', function() { isDrawing = false; });
canvas.addEventListener('mouseleave', function() { isDrawing = false; });
</script>

</body>
</html>
